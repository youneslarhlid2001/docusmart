# ============================================================
# DocuSmart — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Google AI ---
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GOOGLE_PROJECT_ID=your-project-id
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
DOCUMENT_AI_LOCATION=eu
GEMINI_API_KEY=your-gemini-api-key

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://docusmart:password@postgres:5432/docusmart

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (Data Lake — Architecture Medallion) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=docusmart
MINIO_SECRET_KEY=docusmart123
MINIO_SECURE=false

# --- Application ---
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
